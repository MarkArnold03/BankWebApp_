@page
@model RegisterModel
@{
    ViewData["Title"] = "Create login";
    ViewData["FullBleed"] = true;
}

<div class="signin">
    <partial name="_BanknoteSide" />
    <div class="signin-main">
        <div class="signin-form">
            <p class="micro">New staff login</p>
            <h1>Create a login</h1>
            <p class="lede">New logins have no role until an administrator gives them one.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="error"></div>
                <div class="form-row">
                    <label asp-for="Input.Email">Email</label>
                    <input class="text-input" asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.Password">Password</label>
                    <input class="text-input" asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                    <span class="hint">At least 6 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.</span>
                </div>
                <div class="form-row">
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <input class="text-input" asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>
                <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg w-100">Create login</button>
            </form>

            <div class="links">
                <span>Already have a login? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
