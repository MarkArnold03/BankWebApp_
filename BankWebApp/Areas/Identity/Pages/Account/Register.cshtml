@page
@model RegisterModel
@{
    ViewData["Title"] = "Create login";
    ViewData["FullBleed"] = true;
}

<div class="signin">
    <div class="mark" aria-hidden="true">@Icons.Svg("bank", 34)</div>
    <h1>Create a login</h1>
    <p class="lede">New logins have no staff role until an administrator gives them one.</p>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <div class="stack">
            <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="Email" aria-label="Email" />
        </div>
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        <div class="stack mt-3">
            <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" placeholder="Password" aria-label="Password" />
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" placeholder="Confirm password" aria-label="Confirm password" />
        </div>
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
        <p class="group-footer mx-1 mt-2 text-start">At least 6 characters, with an uppercase letter, a lowercase letter, a digit and a symbol.</p>
        <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg w-100">Continue</button>
    </form>

    <div class="links">
        <span class="secondary">Already have a login? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
