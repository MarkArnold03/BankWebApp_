@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    ViewData["FullBleed"] = true;
}

<div class="signin">
    <div class="mark" aria-hidden="true">@Icons.Svg("bank", 34)</div>
    <h1>Log in to ManDem Bank</h1>
    <p class="lede">For bank staff. Use your work email and password.</p>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="error"></div>
        <div class="stack">
            <input asp-for="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="Email" aria-label="Email" />
            <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" placeholder="Password" aria-label="Password" />
        </div>
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>
        <label class="remember"><input asp-for="Input.RememberMe" /> Keep me logged in</label>
        <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">Log in</button>
    </form>

    <div class="links">
        <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation email</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
