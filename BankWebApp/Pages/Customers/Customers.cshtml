@page
@model BankWebApp.Pages.Customers.CustomersModel
@{
    ViewData["Title"] = "Customers";
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    var first = (Model.CurrentPage - 1) * 50 + 1;
    var last = first + Model.Customers.Count - 1;
    var columns = new[] { ("CustomerId", "Customer no."), ("NationalId", "Personal ID"), ("FullName", "Name"), ("Address", "Address"), ("City", "City") };

    // Clicking a column sorts by it; clicking it again reverses the order.
    string NextOrder(string column) => Model.SortColumn == column && Model.SortOrder == "asc" ? "desc" : "asc";
    string? SortState(string column) => Model.SortColumn == column ? (Model.SortOrder == "desc" ? "descending" : "ascending") : null;
}

<div class="page-head">
    <h1 class="large-title">Customers</h1>
</div>

<form method="get" class="searchbar" role="search">
    <label class="search-field">@Icons.Svg("search", 18)<input name="searchText" value="@Model.SearchText" placeholder="Name, city or customer number" aria-label="Search customers" autocomplete="off" /></label>
    <button class="btn btn-primary" type="submit">Search</button>
</form>
<p class="number-jump">Search by first name, surname and city, for example <em>anna uppsala</em>. A customer number opens the profile.</p>

<div class="toolbar">
    <h2>@(string.IsNullOrEmpty(Model.SearchText) ? "All customers" : "Results")</h2>
    <span class="secondary num">@(Model.RowCount == 0 ? "No matches" : $"{first.ToString("#,##0", sv)}–{last.ToString("#,##0", sv)} of {Model.RowCount.ToString("#,##0", sv)}")</span>
</div>

@if (Model.RowCount == 0)
{
    <div class="empty">@Icons.Svg("search", 40)<h2>No customers found</h2><p>Check the spelling, or search by surname or city only.</p></div>
}
else
{
    <div class="list customer-table" role="table" aria-label="Customers">
        <div class="ct-row ct-head" role="row">
            @foreach (var (key, label) in columns)
            {
                <span role="columnheader" aria-sort="@SortState(key)">
                    <a class="sort" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@key" asp-route-sortOrder="@NextOrder(key)">
                        @label @(Model.SortColumn == key ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </span>
            }
        </div>
        @foreach (var c in Model.Customers)
        {
            <a class="ct-row" role="row" asp-page="/Customers/CustomerCard" asp-route-customerId="@c.Id">
                <span class="num" role="cell">@c.Id</span>
                <span class="num secondary" role="cell">@(string.IsNullOrEmpty(c.NationalId) ? "–" : c.NationalId)</span>
                <span class="ct-name" role="cell">@c.FullName</span>
                <span class="secondary" role="cell">@c.StreetAddress</span>
                <span role="cell">@c.City</span>
            </a>
        }
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (Model.CurrentPage > 1)
            {
                <a class="btn btn-gray btn-sm" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage - 1)">@Icons.Svg("back", 16) Previous</a>
            }
            <span class="secondary num">Page @Model.CurrentPage of @Model.PageCount.ToString("#,##0", sv)</span>
            @if (Model.CurrentPage < Model.PageCount)
            {
                <a class="btn btn-gray btn-sm" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage + 1)">Next @Icons.Svg("chevron", 16)</a>
            }
        </nav>
    }
}
