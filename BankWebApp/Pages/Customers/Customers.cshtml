@page
@model BankWebApp.Pages.Customers.CustomersModel
@{
    ViewData["Title"] = "Customers";
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    var first = (Model.CurrentPage - 1) * 50 + 1;
    var last = first + Model.Customers.Count - 1;
    var columns = new[] { ("CustomerId", "No.", "num"), ("NationalId", "Personal ID", "hide-sm"), ("FullName", "Name", ""), ("Address", "Address", "hide-sm"), ("City", "City", "") };
    string NextOrder(string column) => Model.SortColumn == column && Model.SortOrder == "asc" ? "desc" : "asc";
    string? SortState(string column) => Model.SortColumn == column ? (Model.SortOrder == "desc" ? "descending" : "ascending") : null;

    // Page numbers around the current page, plus the first and last.
    var pages = Enumerable.Range(Math.Max(1, Model.CurrentPage - 2), Math.Min(Model.PageCount, Model.CurrentPage + 2) - Math.Max(1, Model.CurrentPage - 2) + 1).ToList();
}

<ol class="crumbs"><li><a asp-page="/Index">Overview</a></li><li>Customers</li></ol>
<div class="page-title">
    <div>
        <h1>Customers</h1>
        <p class="lede">Search by first name, surname and city, for example <em>anna uppsala</em>. A customer number opens the customer.</p>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <form method="get" class="toolbar w-100" role="search">
            <label class="field-search">@Icons.Svg("search", 16)<input name="searchText" value="@Model.SearchText" placeholder="Name, city or customer number" aria-label="Search customers" autocomplete="off" /></label>
            <button class="btn btn-primary" type="submit">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchText))
            {
                <a class="btn btn-gray" asp-page="/Customers/Customers">Clear</a>
            }
            <span class="count num">@(Model.RowCount == 0 ? "No matches" : $"{first.ToString("#,##0", sv)}–{last.ToString("#,##0", sv)} of {Model.RowCount.ToString("#,##0", sv)}")</span>
        </form>
    </div>

    @if (Model.RowCount == 0)
    {
        <div class="empty">@Icons.Svg("search", 36)<h2>No customers found</h2><p>Check the spelling, or search by surname or city only.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        @foreach (var (key, label, cls) in columns)
                        {
                            <th scope="col" class="@cls" aria-sort="@SortState(key)">
                                <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@key" asp-route-sortOrder="@NextOrder(key)">@label @(Model.SortColumn == key ? (Model.SortOrder == "desc" ? "▼" : "▲") : "")</a>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td class="num"><span class="serial">@c.Id</span></td>
                            <td class="hide-sm mono">@(string.IsNullOrEmpty(c.NationalId) ? "–" : c.NationalId)</td>
                            <td class="primary-cell"><a asp-page="/Customers/CustomerCard" asp-route-customerId="@c.Id">@c.FullName</a></td>
                            <td class="hide-sm muted">@c.StreetAddress</td>
                            <td>@c.City</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="pager" aria-label="Pages">
                <span>Page @Model.CurrentPage of @Model.PageCount.ToString("#,##0", sv)</span>
                <div class="pages">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage - 1)" aria-label="Previous page">‹</a>
                    }
                    @foreach (var p in pages)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@p" aria-current="@(p == Model.CurrentPage ? "page" : null)">@p</a>
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage + 1)" aria-label="Next page">›</a>
                    }
                </div>
            </nav>
        }
    }
</section>
