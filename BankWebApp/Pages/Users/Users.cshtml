@page
@model BankWebApp.Pages.Users.UsersModel
@{
    ViewData["Title"] = "Users";
}

<ol class="crumbs"><li><a asp-page="/Index">Overview</a></li><li>Users</li></ol>
<div class="page-title">
    <div>
        <h1>Users</h1>
        <p class="lede">Everyone who can log in, and what they're allowed to do. Cashiers manage customers and accounts; admins manage users.</p>
    </div>
</div>

<section class="panel">
    <div class="table-wrap">
        <table class="data">
            <thead><tr><th scope="col">Login</th><th scope="col">Role</th><th scope="col">Status</th></tr></thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="primary-cell"><span>@u.Email</span></td>
                        <td>
                            @if (u.Roles.Count == 0)
                            {
                                <span class="muted">No role: can't open customers or accounts</span>
                            }
                            @foreach (var r in u.Roles)
                            {
                                <span class="tag role">@r</span>
                            }
                        </td>
                        <td>
                            @if (u.LockedOut) { <span class="tag bad">Locked out</span> }
                            else if (!u.EmailConfirmed) { <span class="tag">Email not confirmed</span> }
                            else { <span class="tag ok">Active</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
