@page
@model BankWebApp.Pages.Accounts.DepositModel
@{
    var a = Model.Deposit.Account;
    ViewData["Title"] = "Deposit · " + BankFormat.AccountNumber(a.Id);
    var isPost = HttpMethods.IsPost(Request.Method);
    var panel = new TellerPanelViewModel
    {
        Account = a,
        CustomerId = Model.Deposit.CustomerId,
        Active = "deposit",
        Amount = isPost ? Request.Form["Amount"].ToString() : null,
        AmountError = ViewData.ModelState["Amount"]?.Errors.FirstOrDefault()?.ErrorMessage,
    };
}

<ol class="crumbs">
    <li><a asp-page="/Index">Overview</a></li>
    @if (Model.Deposit.CustomerId > 0)
    {
        <li><a asp-page="/Customers/CustomerCard" asp-route-customerId="@Model.Deposit.CustomerId">Customer № @Model.Deposit.CustomerId</a></li>
    }
    <li><a asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId">Account № @BankFormat.AccountNumber(a.Id)</a></li>
    <li>Deposit</li>
</ol>

<partial name="_AccountHeader" model="panel" />

<div class="grid-account">
    <section class="panel">
        <div class="panel-head"><h2>Deposit</h2></div>
        <div class="panel-body">
            <p class="muted">Book the deposit in the teller panel. The account's ledger is on the <a asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId">account page</a>.</p>
        </div>
    </section>
    <partial name="_TellerPanel" model="panel" />
</div>
