@page
@model BankWebApp.Pages.Accounts.DepositModel
@{
    var a = Model.Deposit.Account;
    ViewData["Title"] = "Deposit";
    ViewData["Narrow"] = true;
}

<a class="back" asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId">@Icons.Svg("back", 22) Account @BankFormat.AccountNumber(a.Id)</a>

<div class="page-head">
    <h1 class="large-title">Deposit</h1>
    <p>Balance <span class="num">@BankFormat.Sek(a.Balance)</span></p>
</div>

<nav class="segmented mb-4" aria-label="Kind of transaction">
    <a asp-page="/Accounts/Deposit" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId" aria-current="@("Deposit" == "Deposit" ? "true" : null)">Deposit</a>
    <a asp-page="/Accounts/Withdrawal" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId" aria-current="@("Deposit" == "Withdraw" ? "true" : null)">Withdraw</a>
    <a asp-page="/Accounts/Transfer" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId" aria-current="@("Deposit" == "Transfer" ? "true" : null)">Transfer</a>
</nav>

<form method="post" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId" novalidate>
    <div asp-validation-summary="ModelOnly" class="field-error mb-3"></div>

    <div class="amount-entry">
        <label asp-for="Amount">Amount in kronor</label>
        <input asp-for="Amount" type="text" inputmode="decimal" placeholder="0" autocomplete="off" value="@(Model.Amount == 0 ? "" : Model.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture))" autofocus />
        <span asp-validation-for="Amount" class="field-error"></span>
    </div>

    <p class="group-footer">Cash paid in at the counter, between 100 and 10 000 kr. The balance updates immediately.</p>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg w-100" id="submit-transaction">Deposit</button>
        <a class="btn btn-link w-100" style="min-height:44px" asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Deposit.CustomerId">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
