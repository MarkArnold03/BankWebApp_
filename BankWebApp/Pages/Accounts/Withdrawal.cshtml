@page
@model BankWebApp.Pages.Accounts.WithdrawalModel
@{
    var a = Model.Withdrawal.Account;
    ViewData["Title"] = "Withdrawal · " + BankFormat.AccountNumber(a.Id);
    var isPost = HttpMethods.IsPost(Request.Method);
    var panel = new TellerPanelViewModel
    {
        Account = a,
        CustomerId = Model.Withdrawal.CustomerId,
        Active = "withdraw",
        Amount = isPost ? Request.Form["Amount"].ToString() : null,
        AmountError = ViewData.ModelState["Amount"]?.Errors.FirstOrDefault()?.ErrorMessage,
    };
}

<ol class="crumbs">
    <li><a asp-page="/Index">Overview</a></li>
    @if (Model.Withdrawal.CustomerId > 0)
    {
        <li><a asp-page="/Customers/CustomerCard" asp-route-customerId="@Model.Withdrawal.CustomerId">Customer № @Model.Withdrawal.CustomerId</a></li>
    }
    <li><a asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Withdrawal.CustomerId">Account № @BankFormat.AccountNumber(a.Id)</a></li>
    <li>Withdrawal</li>
</ol>

<partial name="_AccountHeader" model="panel" />

<div class="grid-account">
    <section class="panel">
        <div class="panel-head"><h2>Withdrawal</h2></div>
        <div class="panel-body">
            <p class="muted">Book the withdrawal in the teller panel. The account's ledger is on the <a asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id" asp-route-customerId="@Model.Withdrawal.CustomerId">account page</a>.</p>
        </div>
    </section>
    <partial name="_TellerPanel" model="panel" />
</div>
