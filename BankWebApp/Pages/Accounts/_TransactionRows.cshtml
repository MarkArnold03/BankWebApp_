@model IEnumerable<TransactionViewModel>
@foreach (var t in Model)
{
    var text = (t.Symbol + " " + t.Operation).ToLowerInvariant();
    var icon = text.Contains("card") ? "card"
        : text.Contains("cash") ? "cash"
        : text.Contains("bank") ? "transfer"
        : text.Contains("interest") ? "interest"
        : t.IsOutgoing ? "out" : "in";
    <div class="cell" data-transaction="@t.TransactionId">
        <span class="glyph">@Icons.Svg(icon, 17)</span>
        <span class="main">
            <span class="title">@t.Title</span>
            <span class="sub">@BankFormat.ShortDate(t.Date)@(string.IsNullOrEmpty(t.Details) ? "" : " · " + t.Details)</span>
        </span>
        <span class="trail">
            <span class="value @(t.IsOutgoing ? "" : "pos")">@BankFormat.SignedSek(t.SignedAmount)<small>@BankFormat.Sek(t.Balance)</small></span>
        </span>
    </div>
}
