@page
@model BankWebApp.Pages.Transactions.TransactionModel
@{
    var a = Model.Account;
    ViewData["Title"] = "Account " + BankFormat.AccountNumber(a.Id);
    var panel = new TellerPanelViewModel { Account = a, CustomerId = Model.CustomerId };
}

<ol class="crumbs">
    <li><a asp-page="/Index">Overview</a></li>
    @if (Model.CustomerId > 0)
    {
        <li><a asp-page="/Customers/Customers">Customers</a></li>
        <li><a asp-page="/Customers/CustomerCard" asp-route-customerId="@Model.CustomerId">Customer № @Model.CustomerId</a></li>
    }
    else
    {
        <li><a asp-page="/Accounts/Accounts">Accounts</a></li>
    }
    <li>Account № @BankFormat.AccountNumber(a.Id)</li>
</ol>

<partial name="_AccountHeader" model="panel" />

<div class="grid-account">
    <section class="panel" aria-labelledby="tx-title">
        <div class="panel-head"><h2 id="tx-title">Ledger</h2><span class="micro">Newest first</span></div>
        @if (Model.Transactions.Count == 0)
        {
            <div class="empty"><h2>No transactions yet</h2><p>Bookings will appear here.</p></div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data ledger">
                    <thead><tr><th scope="col">Date</th><th scope="col">Transaction</th><th scope="col" class="num">Amount</th><th scope="col" class="num hide-sm">Balance</th></tr></thead>
                    <tbody id="transactions">
                        <partial name="_TransactionRows" model="Model.Transactions" />
                    </tbody>
                </table>
            </div>
            @if (Model.HasMore)
            {
                <div class="load-more">
                    <button type="button" class="btn btn-gray" id="load-more"
                            data-url="@Url.Page("/Accounts/Transactions", "FetchMore", new { accountId = a.Id })"
                            data-skip="@Model.Transactions.Count">Load 20 more</button>
                </div>
            }
            <p class="field-error text-center pb-3" id="load-error" role="alert" hidden>Couldn't load more transactions. Try again.</p>
        }
    </section>

    <partial name="_TellerPanel" model="panel" />
</div>

@section Scripts {
    <script>
        (function () {
            var button = document.getElementById("load-more");
            if (!button) return;
            var list = document.getElementById("transactions");
            var error = document.getElementById("load-error");

            button.addEventListener("click", function () {
                var skip = parseInt(button.getAttribute("data-skip"), 10);
                button.disabled = true;
                button.textContent = "Loading…";
                error.hidden = true;

                fetch(button.getAttribute("data-url") + "&skip=" + skip)
                    .then(function (r) {
                        if (!r.ok) throw new Error(r.status);
                        var more = r.headers.get("X-Has-More") === "true";
                        return r.text().then(function (html) { return { html: html, more: more }; });
                    })
                    .then(function (result) {
                        var before = list.children.length;
                        list.insertAdjacentHTML("beforeend", result.html);
                        button.setAttribute("data-skip", skip + (list.children.length - before));
                        if (result.more) {
                            button.disabled = false;
                            button.textContent = "Load 20 more";
                        } else {
                            button.parentElement.remove();
                        }
                    })
                    .catch(function () {
                        error.hidden = false;
                        button.disabled = false;
                        button.textContent = "Load 20 more";
                    });
            });
        })();
    </script>
}
