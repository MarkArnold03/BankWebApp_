@page
@model BankWebApp.Pages.Accounts.AccountsModel
@{
    ViewData["Title"] = "Accounts";
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    var first = (Model.CurrentPage - 1) * 50 + 1;
    var last = first + Model.Accounts.Count - 1;
    var columns = new[] { ("AccountId", "Account no."), ("Frequency", "Statements"), ("Created", "Opened"), ("Balance", "Balance") };
    string NextOrder(string column) => Model.SortColumn == column && Model.SortOrder == "asc" ? "desc" : "asc";
    string? SortState(string column) => Model.SortColumn == column ? (Model.SortOrder == "desc" ? "descending" : "ascending") : null;
}

<div class="page-head">
    <h1 class="large-title">Accounts</h1>
</div>

<form method="get" class="searchbar" role="search">
    <label class="search-field">@Icons.Svg("search", 18)<input name="searchText" value="@Model.SearchText" placeholder="Account number or statement frequency" aria-label="Search accounts" autocomplete="off" /></label>
    <button class="btn btn-primary" type="submit">Search</button>
</form>
<p class="number-jump">An account number opens the account. "Monthly" or "Weekly" lists accounts with that statement cycle.</p>

<div class="toolbar">
    <h2>@(string.IsNullOrEmpty(Model.SearchText) ? "All accounts" : "Results")</h2>
    <span class="secondary num">@(Model.RowCount == 0 ? "No matches" : $"{first.ToString("#,##0", sv)}–{last.ToString("#,##0", sv)} of {Model.RowCount.ToString("#,##0", sv)}")</span>
</div>

@if (Model.RowCount == 0)
{
    <div class="empty">@Icons.Svg("search", 40)<h2>No accounts found</h2><p>Try an exact account number.</p></div>
}
else
{
    <div class="list customer-table account-table" role="table" aria-label="Accounts">
        <div class="ct-row ct-head" role="row">
            @foreach (var (key, label) in columns)
            {
                <span role="columnheader" aria-sort="@SortState(key)">
                    <a class="sort" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@key" asp-route-sortOrder="@NextOrder(key)">
                        @label @(Model.SortColumn == key ? (Model.SortOrder == "desc" ? "↓" : "↑") : "")
                    </a>
                </span>
            }
        </div>
        @foreach (var a in Model.Accounts)
        {
            <a class="ct-row" role="row" asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id">
                <span class="num ct-name" role="cell">@BankFormat.AccountNumber(a.Id)</span>
                <span class="secondary" role="cell">@(a.Frequency == "AfterTransaction" ? "After each transaction" : a.Frequency)</span>
                <span class="secondary num" role="cell">@a.Created.ToString("yyyy-MM-dd")</span>
                <span class="num text-end" role="cell">@BankFormat.Sek(a.Balance)</span>
            </a>
        }
    </div>

    @if (Model.PageCount > 1)
    {
        <nav class="pager" aria-label="Pages">
            @if (Model.CurrentPage > 1)
            {
                <a class="btn btn-gray btn-sm" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage - 1)">@Icons.Svg("back", 16) Previous</a>
            }
            <span class="secondary num">Page @Model.CurrentPage of @Model.PageCount.ToString("#,##0", sv)</span>
            @if (Model.CurrentPage < Model.PageCount)
            {
                <a class="btn btn-gray btn-sm" asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage + 1)">Next @Icons.Svg("chevron", 16)</a>
            }
        </nav>
    }
}
