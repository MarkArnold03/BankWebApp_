@page
@model BankWebApp.Pages.Accounts.AccountsModel
@{
    ViewData["Title"] = "Accounts";
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    var first = (Model.CurrentPage - 1) * 50 + 1;
    var last = first + Model.Accounts.Count - 1;
    var columns = new[] { ("AccountId", "Account", ""), ("Frequency", "Statements", "hide-sm"), ("Created", "Opened", "hide-sm"), ("Balance", "Balance", "num") };
    string NextOrder(string column) => Model.SortColumn == column && Model.SortOrder == "asc" ? "desc" : "asc";
    string? SortState(string column) => Model.SortColumn == column ? (Model.SortOrder == "desc" ? "descending" : "ascending") : null;
    var pages = Enumerable.Range(Math.Max(1, Model.CurrentPage - 2), Math.Min(Model.PageCount, Model.CurrentPage + 2) - Math.Max(1, Model.CurrentPage - 2) + 1).ToList();
}

<ol class="crumbs"><li><a asp-page="/Index">Overview</a></li><li>Accounts</li></ol>
<div class="page-title">
    <div>
        <h1>Accounts</h1>
        <p class="lede">An account number opens its ledger. "Monthly" or "Weekly" lists accounts with that statement cycle.</p>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <form method="get" class="toolbar w-100" role="search">
            <label class="field-search">@Icons.Svg("search", 16)<input name="searchText" value="@Model.SearchText" placeholder="Account number or statement cycle" aria-label="Search accounts" autocomplete="off" /></label>
            <button class="btn btn-primary" type="submit">Search</button>
            <span class="count num">@(Model.RowCount == 0 ? "No matches" : $"{first.ToString("#,##0", sv)}–{last.ToString("#,##0", sv)} of {Model.RowCount.ToString("#,##0", sv)}")</span>
        </form>
    </div>

    @if (Model.RowCount == 0)
    {
        <div class="empty">@Icons.Svg("search", 36)<h2>No accounts found</h2><p>Try an exact account number.</p></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data">
                <thead>
                    <tr>
                        @foreach (var (key, label, cls) in columns)
                        {
                            <th scope="col" class="@cls" aria-sort="@SortState(key)"><a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@key" asp-route-sortOrder="@NextOrder(key)">@label @(Model.SortColumn == key ? (Model.SortOrder == "desc" ? "▼" : "▲") : "")</a></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Accounts)
                    {
                        <tr>
                            <td class="primary-cell"><a class="serial" asp-page="/Accounts/Transactions" asp-route-accountId="@a.Id">№ @BankFormat.AccountNumber(a.Id)</a></td>
                            <td class="hide-sm muted">@(a.Frequency == "AfterTransaction" ? "After each transaction" : a.Frequency)</td>
                            <td class="hide-sm mono muted">@a.Created.ToString("yyyy-MM-dd")</td>
                            <td class="num">@BankFormat.Sek(a.Balance)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <nav class="pager" aria-label="Pages">
                <span>Page @Model.CurrentPage of @Model.PageCount.ToString("#,##0", sv)</span>
                <div class="pages">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage - 1)" aria-label="Previous page">‹</a>
                    }
                    @foreach (var p in pages)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@p" aria-current="@(p == Model.CurrentPage ? "page" : null)">@p</a>
                    }
                    @if (Model.CurrentPage < Model.PageCount)
                    {
                        <a asp-route-searchText="@Model.SearchText" asp-route-sortColumn="@Model.SortColumn" asp-route-sortOrder="@Model.SortOrder" asp-route-pageNo="@(Model.CurrentPage + 1)" aria-label="Next page">›</a>
                    }
                </div>
            </nav>
        }
    }
</section>
