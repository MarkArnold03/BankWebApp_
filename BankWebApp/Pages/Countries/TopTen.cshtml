@page
@model BankWebApp.Pages.Countries.TopTenModel
@{
    ViewData["Title"] = "Top 10 · " + Model.CountryName;
    var canOpen = User.IsInRole("Cashier");
    var rank = 0;
}

<a class="back" asp-page="/Index">@Icons.Svg("back", 22) Overview</a>

<div class="page-head d-flex align-items-center gap-3">
    <img class="flag flag-lg" src="~/assets/images/@(Model.CountryCode)-flag-png-large.png" alt="" />
    <div>
        <div class="page-eyebrow">Top 10 accounts</div>
        <h1 class="large-title">@Model.CountryName</h1>
    </div>
</div>

@if (!Model.Top10Customers.Any())
{
    <div class="empty"><h2>No accounts in @Model.CountryName</h2></div>
}
else
{
    <ol class="list ranking">
        @foreach (var c in Model.Top10Customers)
        {
            rank++;
            <li>
                @if (canOpen)
                {
                    <a class="cell" asp-page="/Accounts/Transactions" asp-route-accountId="@c.AccountId" asp-route-customerId="@c.Id">
                        <span class="rank num">@rank</span>
                        <span class="main"><span class="title">@c.Name</span><span class="sub">Account @BankFormat.AccountNumber(c.AccountId)@(string.IsNullOrEmpty(c.Emailaddress) ? "" : " · " + c.Emailaddress)</span></span>
                        <span class="trail"><span class="value">@BankFormat.Sek(c.Balance)</span>@Icons.Svg("chevron", 16, "chev")</span>
                    </a>
                }
                else
                {
                    <div class="cell">
                        <span class="rank num">@rank</span>
                        <span class="main"><span class="title">@c.Name</span><span class="sub">Account @BankFormat.AccountNumber(c.AccountId)@(string.IsNullOrEmpty(c.Emailaddress) ? "" : " · " + c.Emailaddress)</span></span>
                        <span class="trail"><span class="value">@BankFormat.Sek(c.Balance)</span></span>
                    </div>
                }
            </li>
        }
    </ol>
}
