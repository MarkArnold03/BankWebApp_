@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["FullBleed"] = true;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    var t = Model.Totals;
    string Whole(decimal v) => Math.Round(v, 0).ToString("#,##0", sv) + " kr";
    var hour = DateTime.Now.Hour;
    var greeting = hour < 10 ? "Good morning" : hour < 18 ? "Good afternoon" : "Good evening";
}

@if (signedIn)
{
    <div class="page-head">
        <div class="page-eyebrow">@DateTime.Today.ToString("dddd d MMMM", System.Globalization.CultureInfo.InvariantCulture)</div>
        <h1 class="large-title">@greeting</h1>
    </div>

    <div class="figure">
        <div class="caption">Total balance, all accounts</div>
        <div class="value">@BankFormat.Sek(t.TotalAccountValue).Replace(" kr", "")<span class="unit">kr</span></div>
        @if (User.IsInRole("Cashier"))
        {
            <div class="buttons">
                <a class="btn btn-primary" asp-page="/Customers/Customers">@Icons.Svg("search", 18) Find a customer</a>
                <a class="btn btn-gray" asp-page="/Accounts/Accounts">All accounts</a>
            </div>
        }
    </div>

    <div class="two-col">
        <section class="group" aria-labelledby="countries-title">
            <div class="group-header"><h2 id="countries-title">By country</h2></div>
            <ul class="list">
                @foreach (var (code, name) in IndexModel.Countries)
                {
                    var c = Model.ViewModels[code];
                    <li>
                        <a class="cell" asp-page="/Countries/TopTen" asp-route-countryId="@code">
                            <img class="flag" src="~/assets/images/@(code)-flag-png-large.png" alt="" />
                            <span class="main">
                                <span class="title">@name</span>
                                <span class="sub num">@c.NumberOfClients.ToString("#,##0", sv) customers · @c.NumberOfAccounts.ToString("#,##0", sv) accounts</span>
                            </span>
                            <span class="trail"><span class="value">@Whole(c.TotalAccountValue)</span>@Icons.Svg("chevron", 16, "chev")</span>
                        </a>
                    </li>
                }
            </ul>
            <p class="group-footer">Open a country to see its ten largest accounts.</p>
        </section>

        <section class="group" aria-labelledby="bank-title">
            <div class="group-header"><h2 id="bank-title">The bank today</h2></div>
            <ul class="list">
                <li><div class="cell"><span class="main">Customers</span><span class="trail label-value num">@t.NumberOfClients.ToString("#,##0", sv)</span></div></li>
                <li><div class="cell"><span class="main">Accounts</span><span class="trail label-value num">@t.NumberOfAccounts.ToString("#,##0", sv)</span></div></li>
                <li><div class="cell"><span class="main">Average balance</span><span class="trail label-value num">@BankFormat.Sek(t.NumberOfAccounts == 0 ? 0 : Math.Round(t.TotalAccountValue / t.NumberOfAccounts, 2))</span></div></li>
            </ul>
        </section>
    </div>
}
else
{
    <section class="section hero">
        <div class="inner">
            <h1 class="headline">ManDem Bank.<br />At a glance.</h1>
            <p class="subhead">The bank for the mandem around the world. Staff find any customer, follow every transaction, and handle deposits, withdrawals and transfers.</p>
            <div class="cta-row">
                <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Log in</a>
                <a class="link-chevron" href="#countries">Top banking countries @Icons.Svg("chevron", 16)</a>
            </div>

            <dl class="stats" aria-label="The bank today">
                <div><dt>Customers</dt><dd class="num">@t.NumberOfClients.ToString("#,##0", sv)</dd></div>
                <div><dt>Accounts</dt><dd class="num">@t.NumberOfAccounts.ToString("#,##0", sv)</dd></div>
                <div><dt>Total balance</dt><dd class="num">@Whole(t.TotalAccountValue)</dd></div>
            </dl>
            <p class="stats-note">Live from the bank's database.</p>
        </div>
    </section>

    <section class="section gray" id="countries">
        <div class="inner">
            <h2 class="section-title">Top banking countries.</h2>
            <p class="section-copy">Customers, accounts and capital in each country. Staff can open a country to see its ten largest accounts.</p>
        </div>
        <div class="country-grid">
            @foreach (var (code, name) in IndexModel.Countries)
            {
                var c = Model.ViewModels[code];
                <a class="country" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Countries/TopTen", new { countryId = code })">
                    <img src="~/assets/images/@(code)-flag-png-large.png" alt="Flag of @name" />
                    <h3>@name</h3>
                    <dl>
                        <div><dt>Customers</dt><dd class="num">@c.NumberOfClients.ToString("#,##0", sv)</dd></div>
                        <div><dt>Accounts</dt><dd class="num">@c.NumberOfAccounts.ToString("#,##0", sv)</dd></div>
                        <div><dt>Capital</dt><dd class="num">@Whole(c.TotalAccountValue)</dd></div>
                    </dl>
                    <span class="link-chevron">Log in to see the top 10 accounts @Icons.Svg("chevron", 14)</span>
                </a>
            }
        </div>
    </section>

    <section class="section">
        <div class="inner">
            <h2 class="section-title">Ready when you are.</h2>
            <p class="section-copy">Log in with your staff email and password.</p>
            <div class="cta-row">
                <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Login">Log in</a>
            </div>
        </div>
    </section>
}
